# --- 로컬 Docker MySQL ---
MYSQL_DATABASE=babi_order
MYSQL_USER=babi
MYSQL_PASSWORD=babi_local_password
MYSQL_ROOT_PASSWORD=babi_root_password
MYSQL_PORT=3306

# --- 앱 JDBC 접속 ---
# 로컬: babi_order
# EC2 운영(/opt/babi-order/.env): DB_NAME=babi_order
# EC2 개발(/opt/babi-order-dev/.env): DB_NAME=babi_order_dev  (운영과 반드시 다른 DB명)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=babi_order
DB_USERNAME=babi
DB_PASSWORD=babi_local_password

# Spring 프로파일 (로컬 기본: dev / EC2는 배포 스크립트가 주입)
SPRING_PROFILES_ACTIVE=dev

TOSS_SECRET_KEY=
TOSS_BASE_URL=https://api.tosspayments.com

# 메뉴 이미지 저장용 S3 버킷 (자격증명은 EC2 IAM 역할로 처리되므로 액세스 키는 불필요)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=babi-order-images

# 프론트엔드 Origin (웹 도메인만). API 도메인(babidndn.shop / dev-api.babidndn.shop)은 넣지 않음
# main web: https://www.babidndn.shop  /  dev web: https://dev.babidndn.shop
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://babidundeun.vercel.app,https://www.babidndn.shop,https://dev.babidndn.shop

# 관리자 로그인 아이디
ADMIN_LOGIN_ID=admin

# 관리자 로그인 비밀번호 (배포 환경에서는 반드시 변경)
ADMIN_PASSWORD=admin_local_password

# 관리자 JWT 서명 비밀 키 (배포 환경에서는 32바이트 이상의 안전한 랜덤 값 사용)
JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes

# 서비스 문의 메일 (Gmail SMTP — 앱 비밀번호 사용)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=babidndn.hufs@gmail.com
MAIL_PASSWORD=
MAIL_FROM=babidndn.hufs@gmail.com
MAIL_TO=leegeonu02@gmail.com
